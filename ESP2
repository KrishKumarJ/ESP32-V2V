// ============================================================
// API
// ============================================================

void handleData() {

    currentRSSI =
        WiFi.RSSI();

    estimatedDistance =
        calculateDistance(
            currentRSSI
        );

    String proximity =
        getProximity(
            estimatedDistance
        );

    // Consider sensor lost after 2 seconds
    if (
        millis() - lastPacketTime > 2000
    ) {

        sensorConnected = false;
    }

    String json = "{";

    json += "\"rssi\":";
    json += currentRSSI;

    json += ",";

    json += "\"distance\":";
    json += String(
        estimatedDistance,
        2
    );

    json += ",";

    json += "\"proximity\":\"";
    json += proximity;
    json += "\"";

    json += ",";

    json += "\"packet\":";
    json += packet.packetNumber;

    json += ",";

    json += "\"ax\":";
    json += packet.ax;

    json += ",";

    json += "\"ay\":";
    json += packet.ay;

    json += ",";

    json += "\"az\":";
    json += packet.az;

    json += ",";

    json += "\"gx\":";
    json += packet.gx;

    json += ",";

    json += "\"gy\":";
    json += packet.gy;

    json += ",";

    json += "\"gz\":";
    json += packet.gz;

    json += ",";

    json += "\"sensorConnected\":";

    json += sensorConnected
        ? "true"
        : "false";

    json += "}";

    server.send(
        200,
        "application/json",
        json
    );
}

// ============================================================
// ROOT
// ============================================================

void handleRoot() {

    server.send_P(
        200,
        "text/html",
        webpage
    );
}

// ============================================================
// SETUP
// ============================================================

void setup() {

    Serial.begin(115200);

    delay(1000);

    WiFi.mode(WIFI_STA);

    WiFi.begin(
        WIFI_SSID,
        WIFI_PASSWORD
    );

    Serial.print("Connecting");

    while (
        WiFi.status() != WL_CONNECTED
    ) {

        delay(500);

        Serial.print(".");
    }

    Serial.println();

    Serial.println("WiFi connected.");

    Serial.print("ESP32-B IP: ");

    Serial.println(
        WiFi.localIP()
    );

    udp.begin(
        UDP_PORT
    );

    server.on(
        "/",
        handleRoot
    );

    server.on(
        "/api/data",
        handleData
    );

    server.begin();

    Serial.println(
        "Web server started."
    );
}

// ============================================================
// LOOP
// ============================================================

void loop() {

    server.handleClient();

    receiveSensorPacket();

    static unsigned long lastPrint = 0;

    if (
        millis() - lastPrint >= 1000
    ) {

        lastPrint = millis();

        currentRSSI =
            WiFi.RSSI();

        estimatedDistance =
            calculateDistance(
                currentRSSI
            );

        Serial.print("RSSI: ");

        Serial.print(
            currentRSSI
        );

        Serial.print(" dBm | Distance: ");

        Serial.print(
            estimatedDistance,
            2
        );

        Serial.print(" m | Packet: ");

        Serial.print(
            packet.packetNumber
        );

        Serial.print(" | AX: ");

        Serial.print(
            packet.ax,
            2
        );

        Serial.print(" AY: ");

        Serial.print(
            packet.ay,
            2
        );

        Serial.print(" AZ: ");

        Serial.println(
            packet.az,
            2
        );
    }
}
