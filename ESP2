#include <WiFi.h>
#include <WiFiUdp.h>
#include <WebServer.h>

// ============================================================
// WIFI
// ============================================================

const char* WIFI_SSID = "ESP32_RANGING";
const char* WIFI_PASSWORD = "12345678";

WebServer server(80);

WiFiUDP udp;

const uint16_t UDP_PORT = 4210;

// ============================================================
// RSSI DISTANCE
// ============================================================

float RSSI_AT_1M = -45.0;

float PATH_LOSS_EXPONENT = 2.2;

int currentRSSI = -100;

float estimatedDistance = 999.0;

// ============================================================
// RECEIVED MPU DATA
// ============================================================

struct SensorPacket {

    uint32_t packetNumber;

    float ax;
    float ay;
    float az;

    float gx;
    float gy;
    float gz;

};

SensorPacket packet;

unsigned long lastPacketTime = 0;

bool sensorConnected = false;

// ============================================================
// DISTANCE
// ============================================================

float calculateDistance(int rssi) {

    return pow(
        10.0,
        (RSSI_AT_1M - rssi) /
        (10.0 * PATH_LOSS_EXPONENT)
    );
}

// ============================================================
// PROXIMITY
// ============================================================

String getProximity(
    float distance
) {

    if (distance < 0.5)
        return "VERY CLOSE";

    if (distance < 1.5)
        return "CLOSE";

    if (distance < 3.0)
        return "MEDIUM";

    return "FAR";
}

// ============================================================
// UDP RECEIVE
// ============================================================

void receiveSensorPacket() {

    int packetSize =
        udp.parsePacket();

    if (packetSize != sizeof(SensorPacket)) {

        return;
    }

    udp.read(
        (uint8_t*)&packet,
        sizeof(packet)
    );

    lastPacketTime = millis();

    sensorConnected = true;
}

