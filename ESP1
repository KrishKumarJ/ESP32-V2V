#include <WiFi.h>
#include <WebServer.h>

// ============================================================
// ESP32-A : ACCESS POINT
// ============================================================

const char* AP_SSID = "ESP32_RANGING";
const char* AP_PASSWORD = "12345678";

WebServer server(80);

// Fixed AP address
IPAddress local_IP(192, 168, 4, 1);
IPAddress gateway(192, 168, 4, 1);
IPAddress subnet(255, 255, 255, 0);

// ============================================================
// WEB PAGE
